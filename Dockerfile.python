# syntax=docker/dockerfile:1.7

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS validator-build
WORKDIR /workspace
COPY dotnet/OpenXmlSdkValidator/ dotnet/OpenXmlSdkValidator/
RUN dotnet publish dotnet/OpenXmlSdkValidator/OpenXmlSdkValidator.csproj \
    -c Release \
    -r linux-x64 \
    --self-contained true \
    -p:PublishSingleFile=true \
    -p:IncludeNativeLibrariesForSelfExtract=true \
    -p:DebugType=None \
    -p:DebugSymbols=false \
    -o /out/validator \
    && cp /usr/share/dotnet/LICENSE.txt /out/validator/dotnet-LICENSE.txt \
    && cp /usr/share/dotnet/ThirdPartyNotices.txt /out/validator/dotnet-ThirdPartyNotices.txt

FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="OOXML Compat Normalize - Python" \
      org.opencontainers.image.description="OOXML normalization web/API service using the Python engine" \
      org.opencontainers.image.source="https://github.com/p4535992/ooxml-compat-normalize"

WORKDIR /app

COPY pyproject.toml README.md ./
COPY LICENSE THIRD_PARTY_NOTICES.md THIRD_PARTY_LICENSES.md /app/licenses/
COPY src/ src/
COPY --from=validator-build /out/validator/OpenXmlSdkValidator /app/validator/OpenXmlSdkValidator
COPY --from=validator-build /out/validator/dotnet-LICENSE.txt /app/licenses/dotnet/LICENSE.txt
COPY --from=validator-build /out/validator/dotnet-ThirdPartyNotices.txt /app/licenses/dotnet/ThirdPartyNotices.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu72 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir . \
    && mkdir -p /data/logs \
    && chmod +x /app/validator/OpenXmlSdkValidator \
    && chown -R 10001:0 /app /data \
    && chmod -R g=u /app /data

ENV OOXML_HTTP_HOST=0.0.0.0 \
    OOXML_HTTP_PORT=8080 \
    OOXML_CONTEXT_PATH=/ooxml-compat-normalize \
    OOXML_LOG_FILE=/data/logs/ooxml-compat-normalize-python.log \
    OOXML_OPENXML_VALIDATOR=/app/validator/OpenXmlSdkValidator \
    OOXML_SDK_VALIDATION=required \
    PYTHONUNBUFFERED=1

USER 10001
EXPOSE 8080

ENTRYPOINT ["python", "-m", "ooxml_compat_normalize.web_server"]
